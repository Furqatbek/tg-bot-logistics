# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=

# Your personal Telegram numeric ID (get it from @userinfobot).
# Receives ETA-change alerts and can use /grant.
ADMIN_TELEGRAM_ID=

# Model used for RC extraction.
# claude-opus-5-5 is the default. claude-sonnet-5-5 is roughly half the price
# per token and is usually sufficient for this extraction task.
ANTHROPIC_MODEL=claude-opus-5-5

# Reasoning effort for extraction: low | medium | high
EXTRACTION_EFFORT=medium

# Timezone used to render pickup/delivery times and ETAs.
TIMEZONE=America/New_York

# Free extractions each user gets before the paywall.
FREE_TRIAL_RCS=5

# Public OSRM routing server. Swap for your own instance if you outgrow
# the demo server's rate limits.
OSRM_URL=https://router.project-osrm.org

# Geocoders, tried in this order: US Census (exact on US street addresses),
# Photon, then Nominatim. All free, none need a key.
CENSUS_URL=https://geocoding.geo.census.gov
PHOTON_URL=https://photon.komoot.io
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_CONTACT=you@example.com
